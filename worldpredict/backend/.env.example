# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:3000

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── SQL Server ───────────────────────────────────────────────────────────────
# Local Windows Auth (không cần user/pass):
DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_NAME=PredictWC2026
# DB_USER=     ← để trống = dùng Windows Auth
# DB_PASSWORD= ← để trống = dùng Windows Auth

# Cloud (Render / Railway):
# DB_SERVER=your-cloud-db.com
# DB_PORT=1433
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_ENCRYPT=true

# ─── Zafronix API ─────────────────────────────────────────────────────────────
ZAFRONIX_API_KEY=zwc_free_90d3afafa3133e3b2da63b58

# ─── Auto-sync interval (giây, mặc định 300 = 5 phút) ────────────────────────
SYNC_INTERVAL_SEC=300
